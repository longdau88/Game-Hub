// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique @db.VarChar(50)
  email        String        @unique @db.VarChar(100)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role              String        @default("user") @db.VarChar(20)
  isVerified        Boolean       @default(false) @map("is_verified")
  isBanned          Boolean       @default(false) @map("is_banned")
  verificationToken String?       @map("verification_token") @db.VarChar(255)
  avatarUrl         String?       @map("avatar_url") @db.Text
  bio               String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  games        Game[]
  library      UserLibrary[]
  ratings      Rating[]
  comments     Comment[]
  reports      Report[]
  gameSessions GameSession[]
  crashReports CrashReport[]
  auditLogs    AuditLog[]
  badges       UserBadge[]
  leaderboardEntries Leaderboard[]
  notifications Notification[]
  following     CreatorFollow[] @relation("Follower")
  followers     CreatorFollow[] @relation("Creator")
  libraryCollections LibraryCollection[]

  @@map("users")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(50) // e.g., 'GAME_APPROVED', 'GAME_REJECTED', 'NEW_COMMENT'
  title     String   @db.VarChar(150)
  message   String   @db.Text
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Game {
  id             String        @id @default(uuid()) @db.Uuid
  title          String        @db.VarChar(150)
  description    String?       @db.Text
  descriptionTranslations Json?   @map("description_translations")
  coverImageUrl  String?       @map("cover_image_url") @db.Text
  r2FolderPath   String        @map("r2_folder_path") @db.Text
  uploaderId     Int?          @map("uploader_id")
  uploader       User?         @relation(fields: [uploaderId], references: [id])
  status         String        @default("pending") @db.VarChar(20)
  rejectReason   String?       @map("reject_reason") @db.Text
  sizeBytes      BigInt?       @map("size_bytes")
  playCount      Int           @default(0) @map("play_count")
  controls       Json?
  engineConfig   Json?         @map("engine_config")
  secretKey      String?       @unique @default(uuid()) @map("secret_key") @db.VarChar(50)
  isFeatured     Boolean       @default(false) @map("is_featured")
  hiddenTags     String?       @map("hidden_tags") @db.Text // Store as comma separated or JSON string
  vectorSynced   Boolean       @default(false) @map("vector_synced")
  searchVector   Unsupported("vector(1536)")? @map("search_vector")
  createdAt      DateTime      @default(now()) @map("created_at")
  libraryEntries UserLibrary[]
  categories     Category[]    @relation("GameCategories")
  ratings        Rating[]
  comments       Comment[]
  reports        Report[]
  versions       GameVersion[]
  sessions       GameSession[]
  crashes        CrashReport[]
  leaderboards   Leaderboard[]

  @@index([status])
  @@index([playCount])
  @@index([uploaderId])
  @@index([createdAt])
  @@map("games")
}

model UserLibrary {
  userId       Int      @map("user_id")
  gameId       String   @map("game_id") @db.Uuid
  collectionId Int?     @map("collection_id")
  addedAt      DateTime @default(now()) @map("added_at")
  user         User     @relation(fields: [userId], references: [id])
  game         Game     @relation(fields: [gameId], references: [id])
  collection   LibraryCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@id([userId, gameId])
  @@map("user_library")
}

model LibraryCollection {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     UserLibrary[]

  @@unique([userId, name])
  @@map("library_collections")
}

model CreatorFollow {
  followerId Int      @map("follower_id")
  creatorId  Int      @map("creator_id")
  createdAt  DateTime @default(now()) @map("created_at")
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  creator    User     @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([followerId, creatorId])
  @@index([creatorId])
  @@map("creator_follows")
}

model Category {
  id               Int    @id @default(autoincrement())
  name             String @unique @db.VarChar(50)
  nameTranslations Json?  @map("name_translations")
  slug             String @unique @db.VarChar(50)
  games            Game[] @relation("GameCategories")

  @@map("categories")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(100)
  code      String   @db.VarChar(8)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model Rating {
  userId  Int      @map("user_id")
  gameId  String   @map("game_id") @db.Uuid
  score   Int      // 1 to 5
  addedAt DateTime @default(now()) @map("added_at")
  user    User     @relation(fields: [userId], references: [id])
  game    Game     @relation(fields: [gameId], references: [id])

  @@id([userId, gameId])
  @@map("ratings")
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  gameId    String   @map("game_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  game      Game     @relation(fields: [gameId], references: [id])

  @@index([gameId, createdAt])
  @@map("comments")
}

model Report {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  gameId    String   @map("game_id") @db.Uuid
  reason    String   @db.Text
  status    String   @default("open") @db.VarChar(20) // open, resolved
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  game      Game     @relation(fields: [gameId], references: [id])

  @@index([status])
  @@map("reports")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(50)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model GameVersion {
  id           Int      @id @default(autoincrement())
  gameId       String   @map("game_id") @db.Uuid
  version      String   @db.VarChar(50)
  r2FolderPath String   @map("r2_folder_path") @db.Text
  changelog    String?  @db.Text
  isActive     Boolean  @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, isActive])
  @@map("game_versions")
}

model GameSession {
  id            Int      @id @default(autoincrement())
  userId        Int?     @map("user_id")
  gameId        String   @map("game_id") @db.Uuid
  sessionLength Int      @map("session_length") // in seconds
  startedAt     DateTime @default(now()) @map("started_at")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("game_sessions")
}

model CrashReport {
  id          Int      @id @default(autoincrement())
  gameId      String   @map("game_id") @db.Uuid
  userId      Int?     @map("user_id")
  errorMsg    String   @map("error_msg") @db.Text
  stackTrace  String?  @map("stack_trace") @db.Text
  browserInfo String?  @map("browser_info") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@map("crash_reports")
}

model EmailTemplate {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  subject   String   @db.VarChar(255)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("email_templates")
}

model EmailCampaign {
  id           Int      @id @default(autoincrement())
  subject      String   @db.VarChar(255)
  body         String   @db.Text
  targetGroup  String?  @map("target_group") @db.VarChar(50) // all, active, etc.
  status       String   @default("draft") @db.VarChar(20) // draft, sending, completed, failed
  sentCount    Int      @default(0) @map("sent_count")
  scheduledFor DateTime? @map("scheduled_for")
  createdAt    DateTime @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  @@map("email_campaigns")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int      @map("admin_id")
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")
  admin     User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Leaderboard {
  id        Int      @id @default(autoincrement())
  gameId    String   @map("game_id") @db.Uuid
  userId    Int      @map("user_id")
  score     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gameId, score(sort: Desc)])
  @@map("leaderboards")
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  nameTranslations Json? @map("name_translations")
  description String?  @db.Text
  descriptionTranslations Json? @map("description_translations")
  iconUrl     String?  @map("icon_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  users       UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    Int      @map("user_id")
  badgeId   Int      @map("badge_id")
  grantedAt DateTime @default(now()) @map("granted_at")
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}
