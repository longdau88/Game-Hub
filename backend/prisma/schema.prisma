// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  username     String        @unique @db.VarChar(50)
  email        String        @unique @db.VarChar(100)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role              String        @default("user") @db.VarChar(20)
  isVerified        Boolean       @default(false) @map("is_verified")
  isBanned          Boolean       @default(false) @map("is_banned")
  verificationToken String?       @map("verification_token") @db.VarChar(255)
  avatarUrl         String?       @map("avatar_url") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  games        Game[]
  library      UserLibrary[]
  ratings      Rating[]
  comments     Comment[]

  @@map("users")
}

model Game {
  id             String        @id @default(uuid()) @db.Uuid
  title          String        @db.VarChar(150)
  description    String?       @db.Text
  coverImageUrl  String?       @map("cover_image_url") @db.Text
  r2FolderPath   String        @map("r2_folder_path") @db.Text
  uploaderId     Int?          @map("uploader_id")
  uploader       User?         @relation(fields: [uploaderId], references: [id])
  status         String        @default("pending") @db.VarChar(20)
  rejectReason   String?       @map("reject_reason") @db.Text
  sizeBytes      BigInt?       @map("size_bytes")
  playCount      Int           @default(0) @map("play_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  libraryEntries UserLibrary[]
  categories     Category[]    @relation("GameCategories")
  ratings        Rating[]
  comments       Comment[]

  @@index([status])
  @@index([playCount])
  @@index([uploaderId])
  @@index([createdAt])
  @@map("games")
}

model UserLibrary {
  userId  Int      @map("user_id")
  gameId  String   @map("game_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")
  user    User     @relation(fields: [userId], references: [id])
  game    Game     @relation(fields: [gameId], references: [id])

  @@id([userId, gameId])
  @@map("user_library")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  slug  String @unique @db.VarChar(50)
  games Game[] @relation("GameCategories")

  @@map("categories")
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(100)
  code      String   @db.VarChar(8)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model Rating {
  userId  Int      @map("user_id")
  gameId  String   @map("game_id") @db.Uuid
  score   Int      // 1 to 5
  addedAt DateTime @default(now()) @map("added_at")
  user    User     @relation(fields: [userId], references: [id])
  game    Game     @relation(fields: [gameId], references: [id])

  @@id([userId, gameId])
  @@map("ratings")
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  gameId    String   @map("game_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  game      Game     @relation(fields: [gameId], references: [id])

  @@map("comments")
}
